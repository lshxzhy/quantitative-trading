# Copy this file to .env, then edit values for your own machine.

# Used to check whether campus network / VPN access is available.
CSMAR_HEALTHCHECK_URL=https://www.csmar.com/

# If your school provides an official CSMAR API, fill these after reading the official docs.
CSMAR_API_BASE_URL=
CSMAR_API_TOKEN=

# Optional: Windows VPN connection name already configured in Windows settings.
# Do not put VPN username/password in this project.
VPN_CONNECTION_NAME=

# Project paths
DATA_DIR=data
DATASETS_FILE=config/datasets.yml

# HTTP settings
REQUEST_TIMEOUT_SECONDS=30

